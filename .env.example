# BahiBar Environment Configuration Example
# Copy this file to .env.local and populate with your own credentials

# Supabase Cloud Database Configuration
# Obtain these from your Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Site Base URL (used for Auth callback redirects and password reset emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Privacy-Conscious Usage Analytics (Optional, Disabled by Default)
# Set to 'true' only if you wish to enable anonymous PostHog / Umami telemetry
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Note: In local development, if NEXT_PUBLIC_SUPABASE_URL is omitted or set to localhost,
# BahiBar automatically uses its zero-config JSON file engine (.local-db.json) for instant offline testing.
